{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imperial Terminal",
  "version": "0.1.0",
  "identifier": "dev.imperial.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Imperial Terminal",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#0b0d10",
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A Linux-first Git client that doesn't hide Git.",
    "longDescription": "Imperial Terminal is a local-first desktop Git client that always shows the real Git command behind every action.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}