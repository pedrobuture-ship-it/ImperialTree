{
  "name": "imperial-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Linux-first Git client that doesn't hide Git.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
